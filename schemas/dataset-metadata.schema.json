{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miyawaki-forest-planner/schemas/dataset-metadata.schema.json",
  "title": "DatasetMetadata",
  "type": "object",
  "required": ["region", "source", "license", "lastUpdated"],
  "properties": {
    "region": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "lastUpdated": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "datasetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "maintainers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewStatus": { "enum": ["draft", "reviewed", "approved"] },
    "sourceUrls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
